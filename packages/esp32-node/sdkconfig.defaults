# Shared by the QEMU and Wokwi builds.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA with automatic rollback when a new image never confirms itself.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Crash evidence survives the reboot and is reported on the next boot.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_COLORS=n
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Three SNTP servers so one lossy server does not delay time sync (main/Kconfig.projbuild).
CONFIG_LWIP_SNTP_MAX_SERVERS=3

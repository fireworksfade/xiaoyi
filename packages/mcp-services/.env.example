IOT_MCP_HOST=127.0.0.1
IOT_MCP_PORT=9000
DIAGNOSIS_DATABASE_PATH=./data/iot_diagnosis.db
DIAGNOSIS_OFFLINE_AFTER_SECONDS=120
DIAGNOSIS_LLM_BASE_URL=https://api.openai.com/v1
DIAGNOSIS_LLM_MODEL=
DIAGNOSIS_LLM_API_KEY=
DIAGNOSIS_LLM_TIMEOUT_SECONDS=20
# query_iot_data (Text2SQL) 复用以上诊断模型配置；为空时明确返回 LLM_NOT_CONFIGURED。
# 前端保存的聊天模型配置不会自动同步到 IoT MCP。详见 docs/text2sql.md。
DIAGNOSIS_QDRANT_URL=
# 对应专用变量优先；删除专用默认值后可使用共享 RETRIEVAL_QDRANT_URL、
# RETRIEVAL_EMBEDDING_BASE_URL / MODEL / API_KEY / DIMENSIONS。
DIAGNOSIS_QDRANT_COLLECTION=iot_diagnosis_knowledge
DIAGNOSIS_SYNC_RETRY_SECONDS=30
DIAGNOSIS_EMBEDDING_PROVIDER=hash
# DashScope 使用百炼原生接口，支持兼容地址自动转换，每批最多 10 条。
DIAGNOSIS_EMBEDDING_BASE_URL=https://api.openai.com/v1
DIAGNOSIS_EMBEDDING_MODEL=
DIAGNOSIS_EMBEDDING_API_KEY=
DIAGNOSIS_EMBEDDING_DIMENSIONS=384
DIAGNOSIS_EMBEDDING_TIMEOUT_SECONDS=20
DIAGNOSIS_EMBEDDING_FALLBACK=true
DIAGNOSIS_EMBEDDING_FALLBACK_DIMENSIONS=384
DIAGNOSIS_QDRANT_FALLBACK_COLLECTION=iot_diagnosis_portable
DIAGNOSIS_VECTOR_BATCH_SIZE=32
DIAGNOSIS_EMBEDDING_QUERY_INSTRUCTION=Given an IoT fault diagnosis query, retrieve relevant technical passages and verified cases
DIAGNOSIS_RERANKER_PROVIDER=weighted
DIAGNOSIS_RERANKER_URL=
# remote: 兼容接口；DashScope: 百炼原生 input/parameters + output.results 协议。
# URL 为完整 rerank 地址；DashScope 必须配置 Bearer 密钥和 model。
DIAGNOSIS_RERANKER_MODEL=
DIAGNOSIS_RERANKER_API_KEY=
DIAGNOSIS_RERANKER_TIMEOUT_SECONDS=30
# 可选的本地 0.6B 第一层兜底；两个远程模型均不可用时继续回退 hash/weighted。
DIAGNOSIS_LOCAL_EMBEDDING_FALLBACK=false
DIAGNOSIS_LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:9010/v1
DIAGNOSIS_LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
DIAGNOSIS_LOCAL_EMBEDDING_API_KEY=local-model-service
DIAGNOSIS_LOCAL_EMBEDDING_DIMENSIONS=512
DIAGNOSIS_LOCAL_EMBEDDING_TIMEOUT_SECONDS=20
DIAGNOSIS_LOCAL_EMBEDDING_QUERY_INSTRUCTION=Given an IoT fault diagnosis query, retrieve relevant technical passages and verified cases
DIAGNOSIS_LOCAL_QDRANT_COLLECTION=iot_diagnosis_qwen3_512
DIAGNOSIS_LOCAL_RERANKER_FALLBACK=false
DIAGNOSIS_LOCAL_RERANKER_URL=http://127.0.0.1:9010/rerank
DIAGNOSIS_LOCAL_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
DIAGNOSIS_LOCAL_RERANKER_API_KEY=
DIAGNOSIS_LOCAL_RERANKER_TIMEOUT_SECONDS=30
DIAGNOSIS_MCP_BEARER_TOKEN=
DIAGNOSIS_MCP_PUBLIC_URL=http://127.0.0.1:9000
DIAGNOSIS_READY_MAX_PENDING_SYNC=1000

# ---- RAG 检索链路（Spec：structure_token 分块 + Dense/BM25/RRF/Reranker）----
# 分块（token 单位）
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# 检索策略：dense / sparse / hybrid（默认 hybrid）
RAG_RETRIEVAL_STRATEGY=hybrid
RAG_DENSE_TOP_K=40
RAG_SPARSE_TOP_K=40
RAG_RRF_K=60
RAG_RERANK_CANDIDATE_LIMIT=60
# Feature flags：允许分别关闭组件用于测试和 fallback
RAG_ENABLE_SPARSE=true
RAG_ENABLE_RRF=true
RAG_ENABLE_RERANKER=true
RAG_RERANKER_RANK_WEIGHT=2.0
RAG_RERANKER_RANK_FUSION_K=60
# 开发环境调试元数据（dense/sparse rank、RRF、reranker score）
RAG_RETRIEVAL_DEBUG=false
# 可选：真实 Qwen tokenizer 路径（缺省用内置启发式 token 计数）
RAG_TOKENIZER_PATH=

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_ENABLED=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# IoT Control（与诊断共用统一 MCP 服务）
CONTROL_DATABASE_PATH=data/iot_control.db
CONTROL_COMMAND_TIMEOUT_SECONDS=30
CONTROL_VERIFY_WINDOW_SECONDS=60
CONTROL_PROPOSAL_TTL_MINUTES=30

# ---- 数据保留策略（WP-07）：默认只做 dry-run 统计 ----
DIAGNOSIS_TELEMETRY_RETENTION_DAYS=14
DIAGNOSIS_INFO_LOG_RETENTION_DAYS=14
DIAGNOSIS_ERROR_LOG_RETENTION_DAYS=90
DIAGNOSIS_RECORD_RETENTION_DAYS=180
DIAGNOSIS_OUTBOX_COMPLETED_RETENTION_DAYS=7
DIAGNOSIS_RETENTION_INTERVAL_HOURS=6
DIAGNOSIS_RETENTION_BATCH_SIZE=1000
# 删除总开关：开启前先备份并核对 dry-run 候选数
DIAGNOSIS_RETENTION_DELETE_ENABLED=false

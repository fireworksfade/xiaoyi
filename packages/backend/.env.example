APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite+aiosqlite:///./data/xiaoyi.db
FRONTEND_ORIGINS=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
INTERNAL_SERVICE_CREDENTIALS={"iot-local":"replace-with-service-secret"}
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_RUNTIME=mock
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# 对话上下文预算（估算 token；历史消息数与附件字符为硬上限）
AGENT_CONTEXT_MAX_INPUT_TOKENS=60000
AGENT_CONTEXT_MAX_HISTORY_MESSAGES=100
AGENT_ATTACHMENT_MAX_CHARS=50000
AGENT_ATTACHMENTS_TOTAL_MAX_CHARS=100000
# 消息分页：默认返回最近一页；MESSAGE_PAGINATION_LEGACY_DEFAULT=true 暂时恢复全量
MESSAGE_PAGINATION_DEFAULT_LIMIT=50
MESSAGE_PAGINATION_MAX_LIMIT=200
MESSAGE_PAGINATION_LEGACY_DEFAULT=false

# 运行事件缓冲：delta 合并阈值与时间窗；工具输出持久化上限
RUN_DELTA_MERGE_CHARS=256
RUN_DELTA_MERGE_MS=200
RUN_TOOL_OUTPUT_MAX_BYTES=65536

# 固定 IoT 工作流、确定性完成门与生命周期 Hook
WORKFLOW_RUNTIME_ENABLED=true
WORKFLOW_VERSION=1
COMPLETION_GATE_ENABLED=true
COMPLETION_GATE_MAX_CONTINUATIONS=2
HOOK_TIMEOUT_MS=500
# Agent 侧 MCP 客户端读超时；外部模型经 MCP 工具变慢时调大
MCP_AGENT_TIMEOUT_SECONDS=15

# 可恢复上下文压缩与完整脱敏工具结果归档
RUN_TOOL_OUTPUT_INLINE_BYTES=65536
RUN_ARTIFACT_ROOT=./data/run-artifacts
RUN_ARTIFACT_RETENTION_HOURS=168
CONTEXT_KEEP_RECENT_TOOL_RESULTS=3
CONTEXT_COMPACTION_TARGET_RATIO=0.8
CONTEXT_REACTIVE_COMPACTION_RETRIES=1
# 保留策略：删除默认关闭（dry-run 只统计）；开启后后台任务按间隔执行实际删除
RETENTION_DELETE_ENABLED=false
RETENTION_INTERVAL_HOURS=6
RETENTION_BATCH_SIZE=1000
UNBOUND_ATTACHMENT_RETENTION_HOURS=24
EXPIRED_SESSION_GRACE_DAYS=7
RUN_EVENTS_COMPACT_AFTER_HOURS=24
RUN_EVENTS_FAILED_RETENTION_HOURS=168

# 就绪探针：声明为必需依赖的 MCP server key（逗号分隔，如 iot-diagnosis-local）。
# 必需 MCP 故障时 /ready 返回 503；未声明的 MCP 属可选依赖，故障不阻止对话历史服务。
MCP_REQUIRED_SERVER_KEYS=

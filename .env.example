# Docker Compose 从仓库根目录 .env 读取配置。
# 留空采用 Compose 档位默认值：基础档位 hash/weighted；模型档位 Qwen3。
# 使用外部 API 时填写 provider、地址、模型、密钥及向量维度；详见 docs/retrieval-api.md。

# Text2SQL / 诊断模型；聊天主模型仍在前端“设置”中配置。
DIAGNOSIS_LLM_BASE_URL=https://api.openai.com/v1
DIAGNOSIS_LLM_MODEL=
DIAGNOSIS_LLM_API_KEY=
DIAGNOSIS_LLM_TIMEOUT_SECONDS=20
# 至少覆盖两次计划生成和数据库执行；LLM 单次为 90 秒时建议设为 210。
MCP_AGENT_TIMEOUT_SECONDS=90

# Embedding：兼容 API 用 openai_compatible；百炼原生 API 用 DashScope（自动转换地址、切批）。
DIAGNOSIS_EMBEDDING_PROVIDER=
DIAGNOSIS_EMBEDDING_BASE_URL=
DIAGNOSIS_EMBEDDING_MODEL=
DIAGNOSIS_EMBEDDING_API_KEY=
DIAGNOSIS_EMBEDDING_DIMENSIONS=
DIAGNOSIS_EMBEDDING_TIMEOUT_SECONDS=20
DIAGNOSIS_VECTOR_BATCH_SIZE=32
# Qwen 查询前缀；其他模型不需要时把此值设为空。
DIAGNOSIS_EMBEDDING_QUERY_INSTRUCTION=Given an IoT fault diagnosis query, retrieve relevant technical passages and verified cases
# 更换 Embedding 模型时填写新的集合名，并重建向量索引。
DIAGNOSIS_QDRANT_COLLECTION=
# API 主模型失败后使用独立的本地 hash 集合；下次请求仍优先尝试 API。
DIAGNOSIS_EMBEDDING_FALLBACK=true
DIAGNOSIS_EMBEDDING_FALLBACK_DIMENSIONS=384
DIAGNOSIS_QDRANT_FALLBACK_COLLECTION=iot_diagnosis_portable

# Reranker：兼容 API 用 remote；百炼原生嵌套协议用 DashScope；URL 填完整地址。
DIAGNOSIS_RERANKER_PROVIDER=
DIAGNOSIS_RERANKER_URL=
DIAGNOSIS_RERANKER_MODEL=
DIAGNOSIS_RERANKER_API_KEY=
DIAGNOSIS_RERANKER_TIMEOUT_SECONDS=30
# API Reranker 失败时先尝试已启用的本地 Qwen，最后回退 weighted；恢复后自动回到 API。

# 第一层兜底：本地 Qwen 0.6B。开启后顺序为 API -> Qwen -> hash/weighted。
DIAGNOSIS_LOCAL_EMBEDDING_FALLBACK=false
DIAGNOSIS_LOCAL_EMBEDDING_BASE_URL=http://retrieval-models:9010/v1
DIAGNOSIS_LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
DIAGNOSIS_LOCAL_EMBEDDING_API_KEY=local-model-service
DIAGNOSIS_LOCAL_EMBEDDING_DIMENSIONS=512
DIAGNOSIS_LOCAL_EMBEDDING_TIMEOUT_SECONDS=20
DIAGNOSIS_LOCAL_EMBEDDING_QUERY_INSTRUCTION=Given an IoT fault diagnosis query, retrieve relevant technical passages and verified cases
DIAGNOSIS_LOCAL_QDRANT_COLLECTION=iot_diagnosis_qwen3_512
DIAGNOSIS_LOCAL_RERANKER_FALLBACK=false
DIAGNOSIS_LOCAL_RERANKER_URL=http://retrieval-models:9010/rerank
DIAGNOSIS_LOCAL_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
DIAGNOSIS_LOCAL_RERANKER_API_KEY=
DIAGNOSIS_LOCAL_RERANKER_TIMEOUT_SECONDS=30
# 兜底服务优先读取已有缓存；首次下载模型时可改为 download。
LOCAL_MODEL_CACHE_MODE=offline
